# Client-side only. Anything secret belongs in the host's environment, never here.
# See docs/ENV.md.

VITE_SITE_URL=http://localhost:5173

# Read by the functions that `npm run dev` serves at /api/*. Safe to keep here:
# neither is a secret. Real keys go in the Netlify UI, never in a file.
PAYMENT_PROVIDER=invoice
PURCHASE_ORDER_LOG_ONLY=true

